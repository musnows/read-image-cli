{
  "name": "@musnows/read-image-cli",
  "version": "0.1.2",
  "description": "Secure image-to-text CLI for OpenAI-compatible vision APIs",
  "type": "module",
  "bin": {
    "read-image": "src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
