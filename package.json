    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "cli",
    "image",
    "vision",
    "openai",
    "openai-compatible",
    "image-to-text"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musnows/read-image-cli.git"
  },
  "bugs": {
    "url": "https://github.com/musnows/read-image-cli/issues"
  },
  "homepage": "https://github.com/musnows/read-image-cli#readme"
}
